{
  "manifest_version": 3,
  "name": "Maps Company Insights",
  "version": "1.0.0",
  "description": "Adds an Insights button to Google Maps when viewing a company or place.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["https://www.google.com/maps/*"],
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Configure Maps Company Insights"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
