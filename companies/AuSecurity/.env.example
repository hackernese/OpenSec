# PostgreSQL - used by the db service
POSTGRES_USER=ausecurity
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ausecurity_db

# Backend - SQLAlchemy async connection string
# Hostname must match the 'db' service name in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://ausecurity:change_me@db:5432/ausecurity_db

# Admin panel credentials (hardcoded — no database required)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Secret key used to sign JWT session tokens — generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# Public origin of the site — used for CORS (no trailing slash)
# Production example: https://ausecurity.best
SITE_ORIGIN=http://localhost:8080

# Optional: forward contact form submissions to this URL (e.g. a webhook, n8n, Zapier, etc.)
# Leave unset or empty to disable forwarding.
WEBHOOK_URL=https://your-webhook-url-here
