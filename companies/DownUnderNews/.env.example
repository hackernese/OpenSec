DB_HOST=localhost
DB_USER=news_user
DB_PASSWORD=news_pass
DB_NAME=newspaper_db
DB_PORT=5432

SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret
JWT_EXPIRES_HOURS=8

APP_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5000
FLASK_ENV=development

# FTP media server
FTP_HOST=<spare-server-ip>
FTP_PORT=21
FTP_USER=mediauser
FTP_PASSWORD=changeme
FTP_USE_TLS=false
FTP_UPLOAD_DIR=/uploads
# Public HTTP base URL where Nginx (or Apache) serves the uploaded files
MEDIA_BASE_URL=http://<spare-server-ip>/uploads