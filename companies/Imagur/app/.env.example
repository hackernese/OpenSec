# App
APP_ENV=development
APP_URL=https://imager.it.com

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=imager
DB_USER=imager
DB_PASSWORD=changeme

# JWT
JWT_SECRET=replace_with_at_least_64_random_bytes_generated_by_openssl_rand_hex_64
JWT_EXPIRES_IN=86400

# AWS S3
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-southeast-2
S3_BUCKET_NAME=imager-dev
S3_PUBLIC_URL_TTL=604800
S3_PRIVATE_URL_TTL=900

# CORS
CORS_ORIGIN=https://imager.it.com

# Upload
MAX_UPLOAD_SIZE_MB=10
